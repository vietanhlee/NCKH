# =============================================================================
# Environment Configuration & API Keys
# Copy file này thành .env và điền các khóa API tương ứng
# =============================================================================

# Hugging Face Access Token (để truy cập và tải weights các mô hình nền tảng DINOv3, DINOv2)
HF_TOKEN=your_huggingface_token_here
HUGGING_FACE_HUB_TOKEN=your_huggingface_token_here

# Weights & Biases API Key (nếu sử dụng để theo dõi quá trình huấn luyện thí nghiệm)
WANDB_API_KEY=your_wandb_api_key_here
